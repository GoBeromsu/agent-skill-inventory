{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "Agent Skill & MCP Inventory",
    "version": "0.1.1"
  },
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devPath": "http://localhost:5175",
    "distDir": "../dist"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.agentinventory.macos",
      "targets": ["dmg", "app", "updater"],
      "macOS": {
        "minimumSystemVersion": "10.13"
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/GoBeromsu/agent-skill-inventory/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1RDQwQzExNzQ1Nzc1QTUKUldTbGRWZDBFUXpVaGNmbVpma1MvSkI2ZkVMMEpCWkh4Wm5MM2hXSnhTdHFqU2NkT1cyR0tSU3MK"
    },
    "windows": [
      {
        "title": "Agent Skill & MCP Inventory",
        "width": 1440,
        "height": 980,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    }
  }
}
