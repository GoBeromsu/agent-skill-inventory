{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "Agent Skill & MCP Inventory",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devPath": "http://localhost:5175",
    "distDir": "../dist"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.agentinventory.macos",
      "targets": ["dmg", "app"]
    },
    "windows": [
      {
        "title": "Agent Skill & MCP Inventory",
        "width": 1440,
        "height": 980,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    }
  }
}
